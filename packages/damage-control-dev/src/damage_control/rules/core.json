{
 "bashToolPatterns": [
  {
   "id": "core.rm-with-recursive-or-force-flags",
   "pattern": "\\brm\\s+(?:(?!--(?:\\s|$))[^\\s;&|]+\\s+)*?-(?!-)[a-z]*[rf][a-z]*(?=[\\s;&|)`]|$)",
   "pattern_src": "\\brm\\s+{ARGS}-(?!-)[a-z]*[rf][a-z]*(?=[\\s;&|)`]|$)",
   "reason": "rm with recursive or force flags",
   "anchored": true
  },
  {
   "id": "core.rm-with-recursive-flag",
   "pattern": "\\brm\\s+(?:(?!--(?:\\s|$))[^\\s;&|]+\\s+)*?--recursive",
   "pattern_src": "\\brm\\s+{ARGS}--recursive",
   "reason": "rm with --recursive flag",
   "anchored": true
  },
  {
   "id": "core.rm-with-force-flag",
   "pattern": "\\brm\\s+(?:(?!--(?:\\s|$))[^\\s;&|]+\\s+)*?--force",
